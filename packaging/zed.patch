new file mode 100644
index 0000000000..a37d065cc8
--- /dev/null
+++ b/crates/gpui_wgpu/src/draw_diagnostics.rs
@@ -0,0 +1,141 @@
+//! Optional synchronous CPU trace boundaries. No platform dependency or clocks.
+use std::{marker::PhantomData, rc::Rc};
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum DrawPhase {
+    Acquire,
+    EncodeSubmit,
+    PresentCall,
+}
+
+/// Hooks must not panic or re-enter the renderer. `begin` returns true exactly
+/// when a section was started; its captured `end` is called on that same thread
+/// even if tracing is subsequently disabled. These describe CPU calls, not GPU
+/// execution or actual presentation acknowledgements.
+#[derive(Clone, Copy)]
+pub struct DrawPhaseHooks {
+    pub begin: fn(DrawPhase) -> bool,
+    pub end: fn(DrawPhase),
+}
+
+#[must_use]
+pub(crate) struct DrawPhaseGuard {
+    end: Option<(DrawPhase, fn(DrawPhase))>,
+    _thread: PhantomData<Rc<()>>,
+}
+impl DrawPhaseGuard {
+    pub(crate) fn new(hooks: Option<DrawPhaseHooks>, phase: DrawPhase) -> Self {
+        let end = hooks
+            .filter(|hook| (hook.begin)(phase))
+            .map(|hook| (phase, hook.end));
+        Self {
+            end,
+            _thread: PhantomData,
+        }
+    }
+}
+impl Drop for DrawPhaseGuard {
+    fn drop(&mut self) {
+        if let Some((phase, end)) = self.end.take() {
+            end(phase);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::{Cell, RefCell};
+    thread_local! {
+        static ENABLED: Cell<bool> = const { Cell::new(true) };
+        static EVENTS: RefCell<Vec<(DrawPhase,bool)>> = const { RefCell::new(Vec::new()) };
+    }
+    fn begin(phase: DrawPhase) -> bool {
+        let active = ENABLED.get();
+        if active {
+            EVENTS.with_borrow_mut(|events| events.push((phase, true)));
+        }
+        active
+    }
+    fn end(phase: DrawPhase) {
+        EVENTS.with_borrow_mut(|events| events.push((phase, false)));
+    }
+    fn hooks() -> Option<DrawPhaseHooks> {
+        EVENTS.with_borrow_mut(Vec::clear);
+        ENABLED.set(true);
+        Some(DrawPhaseHooks { begin, end })
+    }
+    #[test]
+    fn enabled_phases_are_balanced_in_order() {
+        let hooks = hooks();
+        for phase in [
+            DrawPhase::Acquire,
+            DrawPhase::EncodeSubmit,
+            DrawPhase::PresentCall,
+        ] {
+            let _guard = DrawPhaseGuard::new(hooks, phase);
+        }
+        EVENTS.with_borrow(|events| {
+            assert_eq!(
+                *events,
+                vec![
+                    (DrawPhase::Acquire, true),
+                    (DrawPhase::Acquire, false),
+                    (DrawPhase::EncodeSubmit, true),
+                    (DrawPhase::EncodeSubmit, false),
+                    (DrawPhase::PresentCall, true),
+                    (DrawPhase::PresentCall, false)
+                ]
+            )
+        });
+    }
+    #[test]
+    fn disabled_or_absent_hooks_do_not_emit_end() {
+        let hooks = hooks();
+        ENABLED.set(false);
+        drop(DrawPhaseGuard::new(hooks, DrawPhase::Acquire));
+        drop(DrawPhaseGuard::new(None, DrawPhase::PresentCall));
+        EVENTS.with_borrow(|events| assert!(events.is_empty()));
+    }
+    #[test]
+    fn enabled_to_disabled_transition_still_ends_the_started_section() {
+        let hooks = hooks();
+        let guard = DrawPhaseGuard::new(hooks, DrawPhase::PresentCall);
+        ENABLED.set(false);
+        drop(guard);
+        EVENTS.with_borrow(|events| {
+            assert_eq!(
+                *events,
+                vec![
+                    (DrawPhase::PresentCall, true),
+                    (DrawPhase::PresentCall, false)
+                ]
+            )
+        });
+    }
+    #[test]
+    fn return_and_rust_unwind_end_the_section() {
+        fn fail(hooks: Option<DrawPhaseHooks>) -> Result<(), ()> {
+            let _guard = DrawPhaseGuard::new(hooks, DrawPhase::Acquire);
+            Err(())
+        }
+        let hooks = hooks();
+        assert!(fail(hooks).is_err());
+        let result = std::panic::catch_unwind(|| {
+            let _guard = DrawPhaseGuard::new(hooks, DrawPhase::EncodeSubmit);
+            panic!("simulated operation panic");
+        });
+        assert!(result.is_err());
+        EVENTS.with_borrow(|events| {
+            assert_eq!(
+                *events,
+                vec![
+                    (DrawPhase::Acquire, true),
+                    (DrawPhase::Acquire, false),
+                    (DrawPhase::EncodeSubmit, true),
+                    (DrawPhase::EncodeSubmit, false)
+                ]
+            )
+        });
+    }
+}
