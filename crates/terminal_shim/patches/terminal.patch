+    /// Builds an interactive terminal around a PTY byte stream owned by the
+    /// caller. OSC 52 is disabled, as for display-only terminals, so untrusted
+    /// remote output cannot access the local clipboard.
+    pub fn new_external(
+        external: Arc<dyn ExternalPty>,
+        title_override: Option<String>,
+        cursor_shape: SettingsCursorShape,
+        alternate_scroll: AlternateScroll,
+        max_scroll_history_lines: Option<usize>,
+        path_hyperlink_regexes: Vec<String>,
+        path_hyperlink_timeout: Duration,
+        window_id: u64,
+        background_executor: &BackgroundExecutor,
+        path_style: PathStyle,
+    ) -> TerminalBuilder {
+        let mut builder = Self::new_display_only(
+            cursor_shape,
+            alternate_scroll,
+            max_scroll_history_lines,
+            window_id,
+            background_executor,
+            path_style,
+        );
+        builder.terminal.terminal_type = TerminalType::External {
+            pty: Some(external),
+        };
+        builder.terminal.title_override = title_override;
+        builder.terminal.hyperlink_regex_searches =
+            RegexSearches::new(&path_hyperlink_regexes, path_hyperlink_timeout);
+        builder.terminal.is_remote_terminal = true;
+        builder.terminal.template.path_hyperlink_regexes = path_hyperlink_regexes;
+        builder.terminal.template.path_hyperlink_timeout = path_hyperlink_timeout;
+        builder
+    }
