+/// A terminal byte stream whose PTY is owned outside this crate, such as a
+/// remote helper reached over SSH. Methods must enqueue without blocking the UI
+/// thread. `shutdown` must be idempotent.
+pub trait ExternalPty: Send + Sync + 'static {
+    fn write(&self, bytes: Cow<'static, [u8]>);
+    fn resize(&self, bounds: TerminalBounds);
+    fn shutdown(&self);
+}
