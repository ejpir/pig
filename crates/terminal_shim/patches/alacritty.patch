 #[derive(Clone)]
-pub(super) struct ZedListener(UnboundedSender<PtyEvent>);
+pub(super) struct ZedListener {
+    sender: UnboundedSender<PtyEvent>,
+    pending: Arc<AtomicUsize>,
+}
+
+impl ZedListener {
+    pub(super) fn new(sender: UnboundedSender<PtyEvent>) -> Self {
+        Self {
+            sender,
+            pending: Arc::new(AtomicUsize::new(0)),
+        }
+    }
+
+    pub(super) fn pending(&self) -> Arc<AtomicUsize> {
+        self.pending.clone()
+    }
+
+    pub(super) fn send_pty_event(&self, event: PtyEvent) {
+        if self
+            .pending
+            .fetch_update(Ordering::Relaxed, Ordering::Relaxed, |pending| {
+                (pending < MAX_PENDING_EVENTS).then_some(pending + 1)
+            })
+            .is_err()
+        {
+            return;
+        }
+        if self.sender.unbounded_send(event).is_err() {
+            self.pending.fetch_sub(1, Ordering::Relaxed);
+        }
+    }
+}

