# Timing-only capture; no app source/state/coordinates. Keep the trace local.
# NativeActivity buffers may have no app FrameTimeline rows: display rows are
# not proof of this app's presentation rate.
buffers { size_kb: 8192 fill_policy: RING_BUFFER }   # 0: metadata + frames
buffers { size_kb: 65536 fill_policy: RING_BUFFER }  # 1: ftrace

duration_ms: $duration_ms
write_into_file: true
file_write_period_ms: 1000
flush_period_ms: 1000
incremental_state_config { clear_period_ms: 1000 }

data_sources { config {
 name: "linux.ftrace"
 target_buffer: 1
 ftrace_config {
  buffer_size_kb: 2048
  drain_period_ms: 100
  ftrace_events: "sched/sched_switch"
  ftrace_events: "sched/sched_waking"
  ftrace_events: "sched/sched_process_exit"
  ftrace_events: "sched/sched_process_free"
  ftrace_events: "power/cpu_frequency"
  ftrace_events: "power/cpu_idle"
  atrace_categories: "gfx"
  atrace_categories: "view"
  atrace_apps: "$package"
 }
} }
data_sources { config {
 name: "linux.process_stats"
 target_buffer: 0
 process_stats_config {
  scan_all_processes_on_start: true
  record_thread_names: true
  proc_stats_poll_ms: 1000
 }
} }
data_sources { config {
 name: "android.surfaceflinger.frametimeline"
 target_buffer: 0
} }
